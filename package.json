{
  "name": "react-spotlight-card",
  "version": "0.1.0",
  "description": "A lightweight, dependency-free React card component with a cursor-tracking spotlight and glowing border effect.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm install --prefix example && npm run dev --prefix example",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.0.3",
    "vitest": "^2.1.1"
  },
  "keywords": [
    "react",
    "react-component",
    "card",
    "spotlight",
    "glow",
    "hover-effect",
    "cursor",
    "ui"
  ],
  "author": "godwire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/godwire/react-spotlight-card.git"
  },
  "bugs": {
    "url": "https://github.com/godwire/react-spotlight-card/issues"
  },
  "homepage": "https://github.com/godwire/react-spotlight-card#readme",
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
